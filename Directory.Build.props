<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Retain the source-local output exclusions when the declared build root
         moves BaseIntermediateOutputPath outside this checkout. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildProjectDirectory)/bin/**;$(MSBuildProjectDirectory)/obj/**</DefaultItemExcludes>
    <BaseOutputPath Condition="'$(LAPLACE_UCI_BUILD_ROOT)' != ''">$(LAPLACE_UCI_BUILD_ROOT)/bin/$(MSBuildProjectName)/</BaseOutputPath>
    <BaseIntermediateOutputPath Condition="'$(LAPLACE_UCI_BUILD_ROOT)' != ''">$(LAPLACE_UCI_BUILD_ROOT)/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
