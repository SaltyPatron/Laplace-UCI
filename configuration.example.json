{
  "version": 1,
  "listen": "http://127.0.0.1:5192",
  "serverTokenFile": "/etc/laplace-uci/credentials/connector.token",
  "maxSessions": 4,
  "maxLineBytes": 65536,
  "profiles": {
    "mono-local": {
      "label": "Laplace monorepo on this host",
      "implementation": "laplace-mono",
      "environment": "staging",
      "knowledge": "mono-staging",
      "transport": "process",
      "executable": "/opt/laplace/app/uci/laplace-uci",
      "arguments": ["uci", "--engine", "laplace"],
      "environmentFiles": ["/etc/laplace-uci/credentials/mono.env"]
    },
    "mono-ssh": {
      "label": "Laplace monorepo through SSH",
      "implementation": "laplace-mono",
      "environment": "staging",
      "knowledge": "mono-staging",
      "transport": "ssh",
      "sshHost": "knowledge-host",
      "executable": "/opt/laplace-uci/laplace-uci-connect",
      "arguments": ["connect", "--configuration", "/etc/laplace-uci/installation.json", "--profile", "mono-local"]
    },
    "mono-https": {
      "label": "Laplace monorepo through private HTTPS",
      "implementation": "laplace-mono",
      "environment": "staging",
      "knowledge": "mono-staging",
      "transport": "websocket",
      "endpoint": "wss://staging.example.com/uci/mono-local",
      "tokenFile": "/etc/laplace-uci/credentials/connector.token"
    }
  }
}
