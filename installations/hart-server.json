{
  "host": "hart-server",
  "user": "laplace-mono-uci",
  "service": "laplace-mono-uci",
  "revision": "REPLACE_WITH_PUBLISHED_REVISION",
  "install_directory": "/opt/laplace-uci/releases",
  "state_directory": "/var/lib/laplace-mono-uci",
  "configuration_directory": "/etc/laplace-mono/uci",
  "publish_directory": "/repos/work/uci-verification/connector",
  "entrypoint": "/usr/local/bin/laplace-uci-connect",
  "nginx_server_files": [ "/etc/nginx/sites-available/laplace", "/etc/nginx/sites-available/laplace-mono-browser" ],
  "secret_files": { "engine_env": "engine.env", "server_token": "server.token" },
  "connector": {
    "version": 1,
    "listen": "http://127.0.0.1:5192",
    "serverTokenFile": "/var/lib/laplace-mono-uci/secrets/server.token",
    "maxSessions": 2,
    "profiles": {
      "mono-staging": {
        "label": "Laplace monorepo on hart-server",
        "implementation": "laplace-mono",
        "environment": "staging",
        "knowledge": "hart-server/laplace-mono",
        "transport": "process",
        "executable": "/opt/laplace/app/uci/laplace-uci",
        "arguments": [ "uci", "--engine", "laplace" ],
        "environmentFiles": [ "/var/lib/laplace-mono-uci/secrets/engine.env" ],
        "variables": {
          "LD_LIBRARY_PATH": "/opt/laplace/app:/opt/laplace/lib",
          "LAPLACE_INSTALL_PREFIX": "/opt/laplace",
          "LAPLACE_OPS_LOG_DIR": "/var/lib/laplace-mono-uci/logs"
        },
        "workingDirectory": "/var/lib/laplace-mono-uci"
      }
    }
  }
}
